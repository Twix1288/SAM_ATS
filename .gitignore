node_modules/

# Seed data stays on your machine and in the Drive folder, per the brief.
# The spreadsheet carries 41 real people's names, emails, LinkedIn URLs and interview
# transcripts; the cache holds their resumes. Neither belongs in a git remote.
data/
.cache/

# Generated by demo runs; regenerated on every trigger.
ashby-simulator/output/*
!ashby-simulator/output/.gitkeep

# Hand-back package, regenerated by npm run package
*.zip

# Alerts raised at runtime — see sam-integration/delivery/alerts.js
.alerts.jsonl
